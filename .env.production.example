# Warehouse Service production environment template
# Copy this file to .env and replace placeholder values before deploy.

# App
NODE_ENV=production
PORT=3000
APP_TIMEZONE=Asia/Ulaanbaatar

# Database
DB_USER=warehouse_user
DB_PASSWORD=change_me_to_a_strong_database_password
DB_NAME=warehouse_db
DB_PORT=5432
DATABASE_URL=postgresql://warehouse_user:change_me_to_a_strong_database_password@postgres:5432/warehouse_db?schema=public

# API
API_PORT=3000
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com

# Security
JWT_SECRET=replace_with_a_random_secret_minimum_32_characters
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Prisma
PRISMA_CLI_QUERY_ENGINE_TYPE=binary
PRISMA_CLIENT_ENGINE_TYPE=binary

# E-Barimt
EBARIMT_ENABLED=false
EBARIMT_API_URL=http://your-pos-or-ebarimt-endpoint
EBARIMT_MERCHANT_TIN=your_merchant_tin
EBARIMT_POS_NO=your_pos_no
EBARIMT_BRANCH_NO=1
EBARIMT_DISTRICT_CODE=2501

# Optional tools
PGADMIN_EMAIL=admin@warehouse.com
PGADMIN_PASSWORD=change_me_too
PGADMIN_PORT=5050
