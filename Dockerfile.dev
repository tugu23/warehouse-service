# Development Dockerfile with hot-reload

FROM node:18-alpine

WORKDIR /app

# Install OpenSSL 3 and build dependencies
RUN apk add --no-cache openssl3 openssl-dev python3 make g++ bash

# Set Prisma environment variables
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=binary
ENV PRISMA_CLIENT_ENGINE_TYPE=binary

# Placeholder DATABASE_URL for build time (will be overridden at runtime)
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy prisma folder before generate
COPY prisma ./prisma/

# Generate Prisma Client BEFORE copying source code
RUN npx prisma generate

# Copy source code
COPY . .

# Create logs directory
RUN mkdir -p logs

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port
EXPOSE 3000

# Start with entrypoint script
ENTRYPOINT ["/docker-entrypoint.sh"]

